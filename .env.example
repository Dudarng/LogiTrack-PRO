# ==============================================================================
# Configurações do Banco de Dados PostgreSQL - LogiTrack Pro
# ==============================================================================
POSTGRES_DB=logitrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==============================================================================
# Ambiente de Demonstração
# ==============================================================================
# Habilita o botão com credenciais de demonstração na tela de login.
# ATENÇÃO: Deve ser mantido como false fora de ambientes de demonstração/testes.
DEMO_LOGIN=false
